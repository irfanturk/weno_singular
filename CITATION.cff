cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "weno_singular"
abstract: >-
  WENO solvers for linear hyperbolic conservation laws with singular source
  terms. Specialized Python implementations of WENO3 and WENO5 finite-volume
  schemes for 1D linear scalar advection on uniform meshes, with explicit
  (SSP-RK3) and semi-implicit (RK3 + Crank-Nicolson) time integration, and
  built-in support for Dirac-delta point sources.
authors:
  - family-names: "Türk"
    given-names: "İrfan"
version: 0.1.0
date-released: "2026-04-28"
license: Apache-2.0
repository-code: "https://github.com/irfanturk/weno_singular"
keywords:
  - WENO
  - hyperbolic conservation laws
  - singular source terms
  - finite volume
  - Python
references:
  - type: thesis
    authors:
      - family-names: "Türk"
        given-names: "İrfan"
    title: "On the numerical solution of advection diffusion reaction equations with singular source terms"
    institution:
      name: "İstanbul University"
    year: 2016
    url: "https://tez.yok.gov.tr/UlusalTezMerkezi/tezDetay.jsp?id=RnfPVSw2_JaJGF7XtiaayQ"
